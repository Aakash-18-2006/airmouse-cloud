# ============================================================
# AirMouse Cloud - Environment Configuration Template
# Copy this file to .env for local development
# NEVER commit the actual .env file or sensitive secrets to git!
# ============================================================

# Server Port
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# Allowed CORS Origins (comma-separated or * for development)
# In production, set to your frontend domain, e.g. https://airmouse.example.com
CORS_ORIGIN=*

# Session & Security Settings
# Pairing Code Expiry in milliseconds (default: 600000 = 10 minutes)
PAIRING_CODE_TTL_MS=600000

# Max Session Idle Duration in milliseconds (default: 14400000 = 4 hours)
SESSION_MAX_LIFETIME_MS=14400000

# Rate Limiting: Max pairing attempts per IP within window
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_ATTEMPTS=5

# Public Server URL (used by clients / receiver display)
PUBLIC_SERVER_URL=http://localhost:5000
PUBLIC_WS_URL=ws://localhost:5000
